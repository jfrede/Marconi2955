# Receiver test: frequency and level entry, increment keys and VARIABLE knob.
adc 2 10
run 60000000
screen
settings
# RF GEN, FREQ, 145.5 MHz
key 7 1
run 12000000
key 0 2
run 12000000
key 0 3
run 12000000
key 3 3
run 12000000
key 4 3
run 12000000
key 4 4
run 12000000
key 4 3
run 12000000
key 0 5
run 20000000
screen
# LEVEL, -60 dBm
key 6 2
run 12000000
key 5 4
run 12000000
key 5 3
run 12000000
key 1 4
run 12000000
key 2 5
run 20000000
screen
# RF GEN, FREQ, delta INCR, 12.5 kHz
key 7 1
run 12000000
key 0 2
run 12000000
key 7 2
run 12000000
key 0 3
run 12000000
key 1 3
run 12000000
key 4 4
run 12000000
key 4 3
run 12000000
key 3 5
run 20000000
screen
# FREQ up twice, FREQ down once
key 5 6
run 12000000
key 5 6
run 12000000
key 2 6
run 20000000
screen
# VARIABLE knob: 5 steps up, 2 steps down
knob 1
run 800000
knob 1
run 800000
knob 1
run 800000
knob 1
run 800000
knob 1
run 800000
knob -1
run 800000
knob -1
run 20000000
screen
settings
