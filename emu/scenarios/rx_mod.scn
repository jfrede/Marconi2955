# Receiver test: modulation frequency and level with SET MOD and the keypad.
adc 2 10
run 60000000
screen
# SET MOD, FREQ, 2 kHz
key 3 1
run 12000000
key 0 2
run 12000000
key 1 3
run 12000000
key 3 5
run 20000000
screen
# LEVEL, 3 kHz deviation
key 6 2
run 12000000
key 2 3
run 12000000
key 3 5
run 20000000
screen
# FREQ, 300 Hz, then one knob step
key 0 2
run 12000000
key 2 3
run 12000000
key 1 4
run 12000000
key 1 4
run 12000000
key 1 5
run 20000000
screen
knob 1
run 20000000
screen
# LEVEL, 25 kHz deviation, then one knob step
key 6 2
run 12000000
key 1 3
run 12000000
key 4 3
run 12000000
key 3 5
run 20000000
screen
knob 1
run 20000000
screen
# FREQ, 1 kHz: back to the fixed source
key 0 2
run 12000000
key 0 3
run 12000000
key 3 5
run 20000000
screen
# LEVEL, 30 % AM
key 6 2
run 12000000
key 2 3
run 12000000
key 1 4
run 12000000
key 7 5
run 20000000
screen
settings
# MOD ON/OFF
key 4 1
run 20000000
screen
key 4 1
run 20000000
screen
# LEVEL, 3 kHz: back to FM
key 6 2
run 12000000
key 2 3
run 12000000
key 3 5
run 20000000
screen
# RF GEN: the modulation fields are deselected
key 7 1
run 20000000
screen
settings
